[TEMPLATE]
PORT=5001
HOST=0.0.0.0
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
MAX_FILE_SIZE_MB=250
ANALYZE_TIMEOUT_MS=12000
DOWNLOAD_TIMEOUT_MS=30000
MAX_REDIRECTS=4
# Extraction engine (platform sources). Leave YTDLP_PATH empty to report those
# sources as detected-but-unsupported honestly. Point it at a yt-dlp binary to
# enable YouTube, Dailymotion, TikTok and X public media.
YTDLP_PATH=
# Optional; enables real merged video options for DASH-only sources (YouTube).
# When empty, ffmpeg-static (optional npm dependency) is used if installed.
FFMPEG_PATH=
EXTRACT_TIMEOUT_MS=20000
EXTRACT_DOWNLOAD_TIMEOUT_MS=120000
MAX_CONCURRENT_EXTRACTIONS=2
