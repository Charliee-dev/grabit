# Server
PORT=5001
HOST=0.0.0.0

# CORS — comma-separated exact browser origins
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Limits
MAX_FILE_SIZE_MB=250
ANALYZE_TIMEOUT_MS=12000
DOWNLOAD_TIMEOUT_MS=30000
MAX_REDIRECTS=4

# yt-dlp — path to the binary. When unset, platform sources report as unsupported.
# Windows: YTDLP_PATH=./bin/yt-dlp.exe
# Linux/macOS: YTDLP_PATH=./bin/yt-dlp
YTDLP_PATH=

# ffmpeg — enables merged video options for DASH-only sources (YouTube, etc.)
# When unset, falls back to the optional ffmpeg-static npm package.
FFMPEG_PATH=

# Extraction tuning
EXTRACT_TIMEOUT_MS=20000
EXTRACT_DOWNLOAD_TIMEOUT_MS=120000
MAX_CONCURRENT_EXTRACTIONS=2
